{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "sardines-problem-reporter",
  "account_id": "9579a10f586212b0402f24c4db2d0dec",
  "main": "index.js",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "assets": { "directory": "./public", "binding": "REPORTER_ASSETS", "run_worker_first": true },
  "vars": {
    "ALLOWED_ORIGIN": "https://sardines-problem-reporter.lostcharter-studio.workers.dev",
    "GITHUB_OWNER": "lostcharter",
    "GITHUB_REPO": "Sardines-feedback",
    "GITHUB_ASSIGNEE": "lostcharter"
  },
  "ratelimits": [
    { "name": "REPORT_IP_LIMITER", "namespace_id": "19401", "simple": { "limit": 3, "period": 60 } },
    { "name": "REPORT_GLOBAL_LIMITER", "namespace_id": "19402", "simple": { "limit": 10, "period": 60 } }
  ]
}
